#pragma once
#include <opxy/page_header.hpp>

namespace mdapiano {
// Matches resources.display in definition.json: paths, points, nodes, texts, palette.
using Frame = opxy::draw::Frame<4, 64, 113, 18, 16>;
struct DisplayState {
    opxy::draw::PageHeader header;
    opxy::u32 phase, spiral_key, track, initialized, chord_serial;
    opxy::u32 numeral_serial, numeral_tonic, numeral_root, numeral_quality;
    opxy::u32 numeral_elapsed, numeral_active, numeral_last_root;
    opxy::u32 numeral_candidates, numeral_step;
    opxy::u32 previous[4];
    opxy::u32 chord_notes[4];
    opxy::u32 numeral_notes[4];
    opxy::u16 note_age[88];
    opxy::u16 release_age[88];
    opxy::u16 release_level[88];
    opxy::u16 envelope_tau[88];
};
static_assert(sizeof(DisplayState) == 828, "Display state size differs from definition.json");
}
